<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/surface">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zənglər" android:textColor="@color/text" android:textStyle="bold" android:textSize="19sp"/>
        <ImageButton android:id="@+id/dateBtn" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_calendar" android:tint="@color/text" android:padding="11dp" android:background="@drawable/bg_soft"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/all" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Hamısı" android:textAllCaps="false" android:textSize="10sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/incoming" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Gələn" android:textAllCaps="false" android:textSize="10sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/outgoing" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Gedən" android:textAllCaps="false" android:textSize="10sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/missed" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Qaçırılan" android:textAllCaps="false" android:textSize="9sp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingHorizontal="18dp">
        <TextView android:id="@+id/dateLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bu gün" android:textColor="@color/text" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/countLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 zəng" android:textColor="@color/muted" android:textSize="11sp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="8dp" android:paddingBottom="16dp" android:clipToPadding="false"/>
</LinearLayout>
