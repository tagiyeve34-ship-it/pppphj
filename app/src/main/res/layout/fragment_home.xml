<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ailə Nəzarəti" android:textColor="@color/text" android:textStyle="bold" android:textSize="22sp"/>
            <TextView android:id="@+id/bellBtn" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="♧" android:textSize="24sp" android:textColor="@color/text" android:background="@drawable/bg_soft"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="8dp" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/bg_card">
            <TextView android:id="@+id/avatar" android:layout_width="58dp" android:layout_height="58dp" android:gravity="center" android:text="U" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/purple" android:background="@drawable/bg_round_purple"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:id="@+id/childName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uşaq" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:id="@+id/online" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="● Online" android:textColor="@color/green" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/lastSeen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Son görülmə" android:textColor="@color/muted" android:textSize="11sp"/>
            </LinearLayout>
            <TextView android:id="@+id/batteryTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/green" android:textStyle="bold" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/shortcutMap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card"><TextView android:text="●" android:textColor="@color/blue" android:textSize="25sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Xəritə" android:textColor="@color/text" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <LinearLayout android:id="@+id/shortcutCalls" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card"><TextView android:text="☎" android:textColor="@color/green" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Zənglər" android:textColor="@color/text" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <LinearLayout android:id="@+id/shortcutZones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card"><TextView android:text="⌖" android:textColor="@color/purple" android:textSize="27sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Zonalar" android:textColor="@color/text" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <LinearLayout android:id="@+id/shortcutAlerts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card"><TextView android:text="●" android:textColor="@color/red" android:textSize="25sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Bildirişlər" android:textColor="@color/text" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Bu gün" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:background="@drawable/bg_card" android:paddingVertical="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/todayCalls" android:text="0" android:textColor="@color/text" android:textStyle="bold" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Zəng" android:textColor="@color/muted" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/todayPoints" android:text="0" android:textColor="@color/text" android:textStyle="bold" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Mövqe" android:textColor="@color/muted" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/todayDistance" android:text="0 km" android:textColor="@color/text" android:textStyle="bold" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Məsafə" android:textColor="@color/muted" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Analitika" android:textColor="@color/text" android:textStyle="bold" android:textSize="17sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zənglərin analizi" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/callAnalysisTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 zəng" android:textColor="@color/purple" android:textStyle="bold" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_green_soft"><TextView android:id="@+id/incomingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/green" android:textStyle="bold" android:textSize="19sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gələn" android:textColor="@color/muted" android:textSize="10sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_blue_soft"><TextView android:id="@+id/outgoingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/blue" android:textStyle="bold" android:textSize="19sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gedən" android:textColor="@color/muted" android:textSize="10sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_red_soft"><TextView android:id="@+id/missedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/red" android:textStyle="bold" android:textSize="19sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qaçırılan" android:textColor="@color/muted" android:textSize="10sp"/></LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/topNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ən çox danışılan: —" android:textColor="@color/text" android:textStyle="bold" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/zoneCard" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="126dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical" android:padding="15dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zonalar" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/zoneAnalysis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0 aktiv" android:textColor="@color/purple" android:textStyle="bold" android:textSize="20sp"/>
                <TextView android:id="@+id/zoneAnalysisSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:text="Zona məlumatı gözlənilir" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/batteryCard" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="126dp" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:padding="15dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batareya" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/batteryAnalysis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="—%" android:textColor="@color/green" android:textStyle="bold" android:textSize="20sp"/>
                <ProgressBar android:id="@+id/batteryProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="@color/green" android:progressBackgroundTint="@color/line"/>
                <TextView android:id="@+id/batteryAnalysisSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Son GPS ölçümü" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Son fəaliyyət" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="15dp" android:orientation="vertical" android:background="@drawable/bg_card">
            <TextView android:id="@+id/activityLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  Mövqe yeniləndi" android:textColor="@color/text" android:textSize="13sp"/>
            <TextView android:id="@+id/activityCall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="☎  Son zəng yoxdur" android:textColor="@color/text" android:textSize="13sp"/>
            <TextView android:id="@+id/activityZone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="⌖  Zona bildirişi yoxdur" android:textColor="@color/text" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
